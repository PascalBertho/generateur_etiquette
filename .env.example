# URL du projet Supabase utilisé par DS_Sales / bertoolds.com
SUPABASE_URL=https://votre-projet.supabase.co

# Clé serveur Supabase. Ne jamais utiliser NEXT_PUBLIC_ pour cette valeur.
# Utilisez de préférence une nouvelle clé secrète Supabase, ou à défaut service_role.
SUPABASE_SECRET_KEY=votre_cle_secrete_serveur

# Mot de passe permettant d'ouvrir le générateur
APP_PASSWORD=changez-moi

# Chaîne aléatoire longue utilisée pour signer la session
SESSION_SECRET=remplacez-par-au-moins-32-caracteres-aleatoires

# Facultatif : noms exacts des colonnes de la table articles.
# La version fournie reconnaît déjà plusieurs variantes automatiquement.
ARTICLES_VIEW=v_articles_etiquettes
